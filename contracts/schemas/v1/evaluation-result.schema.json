{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khwarizmi.dev/contracts/v1/evaluation-result.schema.json",
  "title": "Khwarizmi Evaluation Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "documentId",
    "documentRevision",
    "semanticVersion",
    "engine",
    "status",
    "results",
    "diagnostics"
  ],
  "properties": {
    "format": {
      "const": "khwarizmi.evaluation-result"
    },
    "schemaVersion": {
      "const": 1
    },
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "documentRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "semanticVersion": {
      "type": "string",
      "minLength": 1
    },
    "unitRegistryVersion": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "cortexjs-compute-engine"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "completed",
        "completedWithErrors",
        "cancelled"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "diagnostic.schema.json"
      }
    }
  },
  "$defs": {
    "scalarValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "decimal"
          ],
          "properties": {
            "kind": {
              "const": "exactDecimal"
            },
            "decimal": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "numerator",
            "denominator"
          ],
          "properties": {
            "kind": {
              "const": "exactRational"
            },
            "numerator": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            },
            "denominator": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "precision"
          ],
          "properties": {
            "kind": {
              "const": "approximate"
            },
            "value": {
              "type": "string"
            },
            "precision": {
              "type": "integer",
              "minimum": 1
            },
            "method": {
              "type": "string"
            }
          }
        }
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbolId",
        "assignmentId",
        "assignmentVersion"
      ],
      "properties": {
        "symbolId": {
          "type": "string"
        },
        "assignmentId": {
          "type": "string"
        },
        "assignmentVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultId",
        "blockId",
        "status",
        "originalMathJson",
        "substitutedMathJson",
        "value",
        "dependencies",
        "diagnostics"
      ],
      "properties": {
        "resultId": {
          "type": "string"
        },
        "blockId": {
          "type": "string"
        },
        "status": {
          "enum": [
            "evaluated",
            "skipped",
            "error"
          ]
        },
        "originalMathJson": {},
        "substitutedMathJson": {},
        "value": {
          "oneOf": [
            {
              "$ref": "#/$defs/scalarValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "diagnostic.schema.json"
          }
        },
        "unit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unitId",
            "dimension"
          ],
          "properties": {
            "unitId": {
              "type": "string"
            },
            "dimension": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "base",
                  "numerator",
                  "denominator"
                ],
                "properties": {
                  "base": {
                    "type": "string"
                  },
                  "numerator": {
                    "type": "string"
                  },
                  "denominator": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
